# Nusxa oling: cp .env.example .env
# Keyin haqiqiy qiymatlarni kiriting. .env fayli hech qachon git'ga qo'shilmasin (.gitignore'da bor).

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ielts_db
BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxx

# Ixtiyoriy — 4-provider fallback zanjiri uchun. Bo'sh qoldirilsa,
# shu provider avtomatik o'tkazib yuboriladi (ilova xato bermaydi).
OPENAI_API_KEY=sk-xxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxx

# python -c "import secrets; print(secrets.token_hex(32))" bilan generatsiya qiling
SECRET_KEY=

REDIS_URL=redis://localhost:6379
ENVIRONMENT=development

# Productionda faqat haqiqiy frontend domenlaringizni yozing (vergul bilan ajrating)
ALLOWED_ORIGINS=http://localhost:3000,https://developuz.com
